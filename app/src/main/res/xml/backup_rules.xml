<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and older backup policy. allowBackup is false in the manifest, so nothing is
  backed up; this file exists to keep the policy explicit for API 29-30 devices.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
