# Gradle / Android build output
.gradle/
build/
**/build/
local.properties
*.iml
.idea/

# Signing material and generated packages
*.jks
*.keystore
*.apk
*.aab

# Voice Guide: the sherpa-onnx AAR is fetched by the downloadSherpaAar Gradle
# task (50 MB, checksum-verified). Models themselves are downloaded to the
# device's filesDir/tts and never live in the repo - these patterns only stop a
# local experiment from being committed.
app/libs/*.aar
*.onnx
*.tar.bz2
voices.bin
espeak-ng-data/
lexicon-*.txt

# OS/editor files
.DS_Store
Thumbs.db
